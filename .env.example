SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
INITIAL_OWNER_EMAIL=teacher@example.com
INITIAL_OWNER_NAME=Имя преподавателя
PLATFORM_ADMIN_EMAIL=admin@example.com
PUBLIC_APP_URL=http://localhost:5173

# Целевой Node/PostgreSQL-контур. Не используйте эти примерные значения в production.
DATABASE_URL=postgresql://tutor:replace-me@127.0.0.1:5432/tutor_platform
AUTH_SECRET=replace-with-at-least-32-random-characters
SMTP_HOST=smtp.mail.selcloud.ru
SMTP_PORT=1127
SMTP_SECURE=true
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=Тьюттори <no-reply@your-domain.example>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Optional relay for servers that cannot reach api.telegram.org directly.
TELEGRAM_API_BASE_URL=
TELEGRAM_RELAY_SECRET=
JOB_INTERVAL_MS=900000

# Зашифрованные резервные копии PostgreSQL во внешнем S3-совместимом хранилище.
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=replace-me
S3_PREFIX=tutor-platform
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# Отдельный префикс фотографий уроков в том же закрытом bucket.
S3_PHOTOS_PREFIX=tutor-platform/lesson-photos
S3_FORCE_PATH_STYLE=false
RESTIC_PASSWORD=replace-with-a-separate-long-random-secret
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
