SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
INITIAL_OWNER_EMAIL=teacher@example.com
INITIAL_OWNER_NAME=Имя преподавателя
PLATFORM_ADMIN_EMAIL=admin@example.com
PUBLIC_APP_URL=http://localhost:5173

# Целевой Node/PostgreSQL-контур. Не используйте эти примерные значения в production.
DATABASE_URL=postgresql://tutor:replace-me@127.0.0.1:5432/tutor_platform
AUTH_SECRET=replace-with-at-least-32-random-characters
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=Tutor Platform <no-reply@example.com>
JOB_INTERVAL_MS=900000
