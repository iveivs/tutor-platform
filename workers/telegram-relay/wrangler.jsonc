{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tyuttori-telegram-relay",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ORIGIN_WEBHOOK_URL": "https://tyuttori.ru/api/telegram/webhook"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 0.1 }
  }
}
