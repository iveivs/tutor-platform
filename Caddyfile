www.{$APP_DOMAIN} {
  redir https://{$APP_DOMAIN}{uri} permanent
}

{$APP_DOMAIN} {
  encode zstd gzip
  reverse_proxy app:3000

  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Strict-Transport-Security "max-age=31536000"
  }

  log {
    output stdout
    format json
  }
}

course.111-88-118-32.sslip.io {
  encode zstd gzip
  handle_path /auth/v1/* {
    reverse_proxy course-auth:9999
  }
  handle_path /rest/v1/* {
    reverse_proxy course-rest:3000
  }
  handle_path /storage/v1/* {
    reverse_proxy course-storage:5000
  }
  handle {
    reverse_proxy course-app:3000
  }
}
