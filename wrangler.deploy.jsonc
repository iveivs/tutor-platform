{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tutor-platform",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tutor-platform-db",
      "database_id": "b06ba7ba-e34e-47d5-9b5e-e3371a4e59b3",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
